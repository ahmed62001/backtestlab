VITE_USE_MOCK=false
VITE_APP_NAME=BacktestLab
# Leave empty for the Vite dev proxy / same-origin production build.
VITE_API_BASE=

# ---------------------------------------------------------------------------
# Backend / database (docker compose reads these from the repository .env)
# ---------------------------------------------------------------------------
# Required in production: use a strong random value, never a placeholder.
POSTGRES_PASSWORD=change-me-to-a-strong-random-value
POSTGRES_USER=backtestlab
POSTGRES_DB=backtestlab
# Required in production: 32+ random characters. The API refuses to boot with
# a placeholder or a short value.
LOCAL_JWT_SECRET=change-me-to-a-random-32-plus-char-secret
CORS_ORIGINS=http://localhost:5173
ENV=production
UVICORN_WORKERS=1
TRUST_PROXY_HEADERS=1

# Shared Redis & Async Queue
REDIS_URL=redis://redis:6379/0
QUEUE_INPROCESS_WORKER=0
ASYNC_BACKTESTS_DEFAULT=1

# HttpOnly Cookie Security (set COOKIE_SECURE=1 when served over HTTPS)
COOKIE_SECURE=0
APP_BASE_URL=http://localhost:5173
# Optional TLS domain for docker-compose.prod.yml + Caddy
# DOMAIN=app.example.com

# Email Password Recovery (none | smtp | resend)
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@backtestlab.local
RESEND_API_KEY=

# Billing (disabled by default; never enable without Stripe keys & terms)
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# ---------------------------------------------------------------------------
# Market Data Providers
# ---------------------------------------------------------------------------
# Twelve Data (multi-asset: US equities, crypto, forex, precious metals)
# Free tier: 800 req/day, 8 req/min (https://twelvedata.com)
TWELVEDATA_API_KEY=your_twelvedata_api_key

# Polygon / Massive (US equities, crypto, forex) (https://polygon.io / https://massive.com)
MASSIVE_API_KEY=your_massive_api_key
POLYGON_API_KEY=your_polygon_api_key

# Federal Reserve Economic Data (macroeconomic indicators & interest rates)
# Free registration at https://fred.stlouisfed.org
FRED_API_KEY=your_fred_api_key

# Optional keyed equity providers (leave empty if not subscribed)
ALPHAVANTAGE_API_KEY=
TIINGO_API_KEY=

# Provider Routing & Fallback Controls
PUBLIC_MARKET_PROVIDER=twelvedata
DATA_PROVIDER_FALLBACK=1
DATA_PROVIDERS_ENABLED=yfinance,ccxt,alphavantage,binance_public,coingecko,frankfurter,fred,tiingo,twelvedata,polygon,csv_upload,local,local_store,synthetic,stooq
