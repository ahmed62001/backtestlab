ENV=dev
DATA_PROVIDER_DEFAULT=yfinance
DATABASE_URL=sqlite:///./backtestlab.db
AUTH_PROVIDER=local
LOCAL_JWT_SECRET=dev-secret-change-me
CORS_ORIGINS=http://localhost:5173
DAILY_RUN_LIMIT_FREE=3
DAILY_RUN_LIMIT_PRO=100
JOB_TIMEOUT_SECONDS=120
MAX_BARS=5000
RESULT_RETENTION_DAYS=365
# Observability (Phase 9): text for local dev, json in containers/production.
LOG_FORMAT=text
LOG_LEVEL=INFO
# Structured HTTP logs already include method/path/status/duration. Uvicorn's
# plain access line is suppressed by default to avoid double-logging every
# request; set to 1 only if you want both.
UVICORN_ACCESS_LOG=0
# Unmatched client probes (e.g. /v1/models) are logged at most once per this
# many seconds per client/path to keep the access log useful.
PROBE_LOG_INTERVAL_S=300
VITE_API_BASE=http://localhost:8000

# Provider catalog: health probes run in parallel and the snapshot is cached.
# Stale snapshots are served while one background thread refreshes them.
PROVIDER_CATALOG_TTL_S=60
PROVIDER_CATALOG_CACHE=1
PROVIDER_HEALTH_TIMEOUT_S=2.0
# Shared anti-bot cooldown used by providers such as Stooq (DB-backed).
PROVIDER_COOLDOWN_S=300
# CoinGecko coin-id list cache (seconds).
COINGECKO_COIN_LIST_TTL_S=604800
# Never sleep longer than this for one Retry-After/backoff step.
DATA_RETRY_MAX_WAIT_S=30

# Login brute-force protection is shared through the database (all API
# processes). The account window is deliberately strict; the IP threshold is
# higher to avoid locking out everyone behind a NAT.
LOGIN_FAILURE_WINDOW_S=900
LOGIN_MAX_ACCOUNT_FAILURES=5
LOGIN_MAX_IP_FAILURES=20

# No payment provider is installed. Billing endpoints return 501
# BILLING_NOT_CONFIGURED and the UI disables checkout while this is false.
BILLING_ENABLED=false

# Optional provider API keys — all optional. Missing keys mark the provider
# as unavailable but do not prevent startup. Only needed if you want to use
# the corresponding keyed provider.
# Alpha Vantage: US equities, FX, crypto (keyed, free tier rate-limited)
ALPHAVANTAGE_API_KEY=
# FRED: US macroeconomic reference series (keyed)
FRED_API_KEY=
# Tiingo: US equities with adjusted prices (keyed)
TIINGO_API_KEY=
# Twelve Data: multi-asset stocks, crypto, forex (keyed, free tier)
TWELVEDATA_API_KEY=
# Live tick streaming over wss://ws.twelvedata.com/v1/quotes/price.
# Disabled by default; enabling requires the key above. Server-side only —
# never expose via VITE_* variables. See docs/MARKET_STREAMING_IMPLEMENTATION_REPORT.md.
MARKET_STREAMING_ENABLED=false
# Twelve Data Basic/Grow trial entitlement: 8 simultaneous subscriptions.
MARKET_STREAM_MAX_SUBSCRIPTIONS=8
# Massive (formerly Polygon.io): US equities, crypto, forex (keyed; free Basic tier is
# rate-limited per asset class — see docs/FX_PROVIDERS.md)
MASSIVE_API_KEY=
# Legacy variable name for Massive (accepted as fallback when MASSIVE_API_KEY is unset)
POLYGON_API_KEY=

# ---------------------------------------------------------------------------
# Runtime / performance knobs (defaults shown; all optional)
# ---------------------------------------------------------------------------
DEBUG=false
ENGINE_MODE=vendor
UVICORN_WORKERS=1
# Trust X-Real-IP / X-Forwarded-For only behind a reverse proxy you control.
TRUST_PROXY_HEADERS=0
JWT_ACCESS_MIN=30
JWT_REFRESH_DAYS=14
PASSWORD_RESET_TTL_MIN=30
LOGIN_MAX_PER_MIN=20
RATE_LIMIT_MAX_KEYS=10000
AUTH_RESET_TOKEN_LOG=0
API_DEFAULT_PAGE_SIZE=50
API_MAX_PAGE_SIZE=200
API_MAX_EQUITY_POINTS=1000
API_MAX_TRADE_ROWS=500
API_MAX_COMPARE_IDS=10
MAX_UPLOAD_ROWS=200000
DAILY_RUN_LIMIT_FREE=3
DAILY_RUN_LIMIT_PRO=100
JOB_TIMEOUT_S=120
JOB_HEARTBEAT_SECONDS=15
JOB_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=3
JOB_RECOVERY_INTERVAL_S=30
JOB_RETRY_BACKOFF_S=5
QUEUE_MAX_WORKERS=2
QUEUE_RECOVER_ON_SUBMIT=1
WORKER_ID=
WORKER_POLL_SECONDS=1.0
WORKER_ALIVE_FILE=/tmp/worker.alive

# Data layer
DATA_PROVIDERS_ENABLED=local,synthetic,csv_upload,stooq,yfinance,ccxt,alphavantage,binance_public,coingecko,frankfurter,fred,tiingo,twelvedata,polygon,local_store
DATA_PROVIDER_FALLBACK=
DATA_CACHE_DIR=/tmp/btlab_cache
DATA_UPLOAD_DIR=/tmp/btlab_uploads
DATA_CACHE_TTL_S=86400
DATA_FETCH_RETRIES=3
DATA_FETCH_BACKOFF_S=1.0
DATA_STORE_TTL_DAILY_DAYS=2
DATA_STORE_TTL_INTRADAY_MINUTES=60
DATA_STORE_TTL_RECENT_HOURS=6
CCXT_EXCHANGE=binance
MAX_BARS=5000

# Database pool / timeouts
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_S=30
DB_POOL_RECYCLE_S=1800
DB_STATEMENT_TIMEOUT_MS=30000
SQLITE_BUSY_TIMEOUT_MS=5000

# Public (pre-login) market endpoint
PUBLIC_MARKET_PROVIDER=twelvedata
PUBLIC_MARKET_DEFAULT_SYMBOL=AAPL
PUBLIC_MARKET_MAX_BARS=500
PUBLIC_MARKET_DEFAULT_LIMIT=250
PUBLIC_MARKET_RATE_LIMIT=60
MARKET_QUOTE_WORKERS=8

# Optional Supabase JWT verification (not wired into the request path yet;
# AUTH_PROVIDER must stay "local" for production boot).
SUPABASE_JWKS_URL=
SUPABASE_ISSUER=
SUPABASE_AUDIENCE=

# Live streaming test override (server-side only)
TWELVEDATA_WS_URL=wss://ws.twelvedata.com/v1/quotes/price

# Testing only — throwaway PostgreSQL target for the P15 test harness.
P15_TEST_PG_HOST=
P15_TEST_PG_PORT=
P15_TEST_PG_SOCKET_DIR=
