# Production TLS reverse proxy for BacktestLab.
# Set DOMAIN (e.g. app.example.com) in the environment before starting
# docker-compose.prod.yml. Caddy automatically provisions TLS 1.2+ certificates
# via ACME and redirects HTTP -> HTTPS.

{$DOMAIN:localhost} {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy frontend:80 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}
}
